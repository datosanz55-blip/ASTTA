# Скопируйте в infra/.env и заполните. Файл .env в git не попадает.
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=astta.ru,www.astta.ru,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://astta.ru,https://www.astta.ru

# Домен сайта и почта для сертификата HTTPS (Let's Encrypt пишет сюда, если что-то не так).
SITE_DOMAIN=astta.ru
ACME_EMAIL=почта-основателя@example.ru

# Защита админки. Адрес — без слешей, придумайте свой: стандартный /admin/ первым делом перебирают боты.
DJANGO_ADMIN_URL=team-замените-на-случайное
# Пусто — админка открывается с любого адреса (но всё равно пароль + код из приложения).
# Через запятую — только с этих IP или подсетей, например офис и VPN: 203.0.113.7,10.8.0.0/24
ADMIN_ALLOWED_IPS=
# Код из приложения (Яндекс Ключ, Google Authenticator) после пароля. Выключать не нужно.
ADMIN_REQUIRE_2FA=1
POSTGRES_DB=astta
POSTGRES_USER=astta
POSTGRES_PASSWORD=замените-на-пароль

# Вход покупателей через Telegram: бот из @BotFather, домен сайта задаётся там командой /setdomain.
# Токен — секрет: с ним можно войти любым покупателем.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=astta_shop_bot
# Секрет вебхука бота: длинная случайная строка, Telegram присылает её с каждым сообщением.
TELEGRAM_WEBHOOK_SECRET=
# Если хостинг в России блокирует Telegram: адрес посредника, например https://tg.имя.workers.dev
# (как сделать — infra/telegram-proxy.js). Пусто — напрямую api.telegram.org.
TELEGRAM_API_URL=

# ASTTA AI: API-ключ сервисного аккаунта Yandex Cloud и каталог. Пусто — ИИ выключен.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest

# Сколько процессов держать. 4 ГБ памяти и больше — по умолчанию (3 и 2).
# Сервер на 2 ГБ: WEB_WORKERS=2 и CELERY_CONCURRENCY=1, плюс файл подкачки (см. backend/README.md).
WEB_WORKERS=3
CELERY_CONCURRENCY=2
