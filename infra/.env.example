# Скопируйте в infra/.env и заполните. Файл .env в git не попадает.
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=astta.ru,www.astta.ru,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://astta.ru,https://www.astta.ru
POSTGRES_DB=astta
POSTGRES_USER=astta
POSTGRES_PASSWORD=замените-на-пароль

# ASTTA AI: API-ключ сервисного аккаунта Yandex Cloud и каталог. Пусто — ИИ выключен.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest
