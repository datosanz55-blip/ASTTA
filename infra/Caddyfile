# Вход на сервер: HTTPS-сертификат Let's Encrypt выпускается и продлевается сам.
# Сайт для покупателей (index.html + assets) и сервер (API, админка) живут на одном домене,
# поэтому браузеру не нужны CORS-разрешения, а cookie админки не уходят на другие сайты.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
	}

	# Каталог с архивом фото — до 1 ГБ за раз.
	request_body {
		max_size 1GB
	}

	# Фото товаров, постов и склада. Только картинки: даже если загрузят что-то другое, браузер
	# не выполнит это как страницу или скрипт.
	handle /media/* {
		root * /srv
		header Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# API и админка: запрет встраивания в чужие страницы ставит сам сервер (X-Frame-Options: DENY).
	@server path /api/* /{$DJANGO_ADMIN_URL}/* /static/* /healthz
	handle @server {
		reverse_proxy backend:8000 {
			# Загрузка каталога с 300 фото обрабатывается около минуты.
			transport http {
				response_header_timeout 180s
			}
		}
	}

	# Всё остальное — сайт для покупателей.
	# CSP: скрипты только свои и Telegram (кнопка входа и мини-приложение), запросы только к нашему серверу.
	# Встраивать сайт можно только самому себе и Telegram: так мини-приложение открывается в Telegram Web,
	# а чужой сайт не может спрятать наши кнопки под своими (кликджекинг).
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://t.me https://telegram.org https://*.telegram.org; media-src 'self' blob:; font-src 'self'; connect-src 'self'; frame-src https://oauth.telegram.org; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
